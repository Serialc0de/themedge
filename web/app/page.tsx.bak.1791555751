import Link from 'next/link';

const API_URL = process.env.NEXT_PUBLIC_API_URL || 'https://admin.themedge.com/api';

async function getArticles() {
  try {
    const res = await fetch(`${API_URL}/articles?per_page=30`, { next: { revalidate: 60 } });
    if (!res.ok) return { data: [] };
    return res.json();
  } catch (e) { return { data: [] }; }
}

async function getCategories() {
  try {
    const res = await fetch(`${API_URL}/categories`, { next: { revalidate: 300 } });
    if (!res.ok) return { data: [] };
    return res.json();
  } catch (e) { return { data: [] }; }
}

function timeAgo(date: string) {
  const seconds = Math.floor((new Date().getTime() - new Date(date).getTime()) / 1000);
  const intervals: [number, string][] = [[31536000, 'anno'], [2592000, 'mese'], [86400, 'giorno'], [3600, 'ora'], [60, 'minuto']];
  for (const [secs, label] of intervals) {
    const counter = Math.floor(seconds / secs);
    if (counter > 0) return `${counter} ${label}${counter > 1 ? 'i' : ''} fa`;
  }
  return 'adesso';
}

export default async function HomePage() {
  const [articlesData, categoriesData] = await Promise.all([getArticles(), getCategories()]);
  const articles = articlesData.data || [];
  const categories = categoriesData.data || [];
  const [mainArticle, ...rest] = articles;
  const sideArticles = rest.slice(0, 2);
  const latest = rest.slice(2, 8);
  const popular = [...articles].sort((a: any, b: any) => b.views - a.views).slice(0, 5);

  // Raggruppa per categoria
  const articlesByCategory: Record<string, any[]> = {};
  categories.forEach((cat: any) => {
    articlesByCategory[cat.slug] = articles.filter((a: any) => a.category?.slug === cat.slug).slice(0, 3);
  });

  const today = new Date().toLocaleDateString('it-IT', {
    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
  });

  return (
    <div className="min-h-screen bg-white">
      {/* ===== TOP BAR ===== */}
      <div className="border-b border-gray-300 bg-white">
        <div className="max-w-7xl mx-auto px-4 py-2 flex justify-between items-center text-xs uppercase tracking-widest text-gray-600">
          <span className="capitalize">{today}</span>
          <span>Edizione italiana</span>
        </div>
      </div>

      {/* ===== MASTHEAD ===== */}
      <header className="border-b-2 border-black">
        <div className="max-w-7xl mx-auto px-4 py-8 md:py-12 text-center">
          <Link href="/" className="inline-block">
            <h1 className="font-serif text-6xl md:text-8xl font-black tracking-tighter leading-none">
              Themedge
            </h1>
          </Link>
          <p className="text-gray-700 mt-3 italic font-serif text-lg md:text-xl">
            Le notizie che contano
          </p>
        </div>
      </header>

      {/* ===== NAV CATEGORIE ===== */}
      <nav className="border-b border-gray-300 bg-white sticky top-0 z-50">
        <div className="max-w-7xl mx-auto px-4">
          <ul className="flex flex-wrap justify-center gap-6 md:gap-8 py-3 text-xs uppercase tracking-widest font-bold">
            <li><Link href="/" className="hover:text-red-700 transition">Home</Link></li>
            {categories.map((cat: any) => (
              <li key={cat.id}>
                <Link href={`/categoria/${cat.slug}`} className="hover:text-red-700 transition">
                  {cat.name}
                </Link>
              </li>
            ))}
            <li><Link href="/cerca" className="hover:text-red-700 transition">Cerca</Link></li>
          </ul>
        </div>
      </nav>

      {/* ===== BREAKING NEWS TICKER ===== */}
      {mainArticle && (
        <div className="bg-red-700 text-white">
          <div className="max-w-7xl mx-auto px-4 py-2 flex items-center gap-3 overflow-hidden">
            <span className="bg-white text-red-700 text-xs font-bold px-2 py-1 uppercase tracking-widest flex-shrink-0">
              Ultim&apos;ora
            </span>
            <Link href={`/articolo/${mainArticle.slug}`} className="text-sm font-semibold hover:underline truncate">
              {mainArticle.title}
            </Link>
          </div>
        </div>
      )}

      <main className="max-w-7xl mx-auto px-4 py-8">
        {articles.length === 0 ? (
          <div className="text-center py-20">
            <p className="text-gray-500 italic font-serif text-2xl mb-4">
              Il giornale sta nascendo.
            </p>
            <p className="text-gray-400 font-serif">
              Pubblica il tuo primo articolo da <Link href="/admin" className="underline">admin.themedge.com</Link>
            </p>
          </div>
        ) : (
          <>
            {/* ===== HERO SECTION ===== */}
            <section className="grid lg:grid-cols-3 gap-8 pb-8 mb-8 border-b-2 border-black">
              {/* Main article */}
              <div className="lg:col-span-2">
                <ArticleHero article={mainArticle} />
              </div>

              {/* 2 side articles */}
              <div className="flex flex-col gap-6 divide-y divide-gray-300 lg:border-l lg:pl-8">
                {sideArticles.map((article: any, i: number) => (
                  <div key={article.id} className={i > 0 ? 'pt-6' : ''}>
                    <ArticleCompact article={article} />
                  </div>
                ))}
              </div>
            </section>

            {/* ===== LATEST + POPULAR ===== */}
            <section className="grid lg:grid-cols-3 gap-10 pb-10 mb-10 border-b-2 border-black">
              <div className="lg:col-span-2">
                <h2 className="font-serif text-2xl font-bold mb-6 pb-2 border-b-2 border-black flex items-center gap-3">
                  <span className="w-1 h-6 bg-red-700"></span>
                  Ultime notizie
                </h2>
                <div className="grid md:grid-cols-2 gap-6">
                  {latest.map((article: any) => (
                    <ArticleCard key={article.id} article={article} />
                  ))}
                </div>
              </div>

              <aside className="lg:border-l lg:pl-8">
                <h2 className="font-serif text-2xl font-bold mb-6 pb-2 border-b-2 border-black flex items-center gap-3">
                  <span className="w-1 h-6 bg-red-700"></span>
                  Più letti
                </h2>
                <ol className="space-y-5">
                  {popular.map((article: any, i: number) => (
                    <li key={article.id} className="flex gap-4">
                      <span className="font-serif text-4xl font-bold text-gray-200 leading-none">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <div>
                        <Link href={`/articolo/${article.slug}`} className="hover:underline">
                          <h3 className="font-serif font-bold leading-tight mb-1 text-base">
                            {article.title}
                          </h3>
                        </Link>
                        <p className="text-xs uppercase tracking-wider text-gray-500">
                          {timeAgo(article.published_at)}
                        </p>
                      </div>
                    </li>
                  ))}
                </ol>
              </aside>
            </section>

            {/* ===== SEZIONI PER CATEGORIA ===== */}
            {categories.map((cat: any) => {
              const catArticles = articlesByCategory[cat.slug] || [];
              if (catArticles.length === 0) return null;
              return (
                <section key={cat.id} className="pb-10 mb-10 border-b border-gray-300 last:border-b-0">
                  <div className="flex justify-between items-end mb-6 pb-2 border-b-2 border-black">
                    <h2 className="font-serif text-3xl font-bold flex items-center gap-3">
                      <span className="w-1.5 h-8" style={{ backgroundColor: cat.color || '#000' }}></span>
                      {cat.name}
                    </h2>
                    <Link href={`/categoria/${cat.slug}`} className="text-xs uppercase tracking-widest font-bold hover:text-red-700 transition">
                      Vedi tutti →
                    </Link>
                  </div>
                  <div className="grid md:grid-cols-3 gap-8">
                    {catArticles.map((article: any, i: number) => (
                      i === 0 ? (
                        <div key={article.id} className="md:col-span-2">
                          <ArticleFeaturedCategory article={article} />
                        </div>
                      ) : (
                        <div key={article.id}>
                          <ArticleCard article={article} />
                        </div>
                      )
                    ))}
                  </div>
                </section>
              );
            })}
          </>
        )}
      </main>

      {/* ===== FOOTER ===== */}
      <footer className="border-t-2 border-black bg-gray-50 mt-12">
        <div className="max-w-7xl mx-auto px-4 py-12">
          <div className="grid md:grid-cols-4 gap-8 mb-8">
            <div className="md:col-span-2">
              <h3 className="font-serif text-3xl font-black mb-3">Themedge</h3>
              <p className="text-gray-600 font-serif italic mb-3">
                Le notizie che contano
              </p>
              <p className="text-sm text-gray-500">
                Giornale online indipendente. Notizie, analisi e approfondimenti dall&apos;Italia e dal mondo.
              </p>
            </div>
            <div>
              <h4 className="text-xs uppercase tracking-widest font-bold mb-4">Sezioni</h4>
              <ul className="space-y-2 text-sm">
                {categories.slice(0, 5).map((cat: any) => (
                  <li key={cat.id}>
                    <Link href={`/categoria/${cat.slug}`} className="text-gray-600 hover:text-black transition">
                      {cat.name}
                    </Link>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h4 className="text-xs uppercase tracking-widest font-bold mb-4">Info</h4>
              <ul className="space-y-2 text-sm">
                <li><Link href="/chi-siamo" className="text-gray-600 hover:text-black transition">Chi siamo</Link></li>
                <li><Link href="/contatti" className="text-gray-600 hover:text-black transition">Contatti</Link></li>
                <li><Link href="/privacy" className="text-gray-600 hover:text-black transition">Privacy</Link></li>
                <li><Link href="/rss" className="text-gray-600 hover:text-black transition">RSS</Link></li>
              </ul>
            </div>
          </div>
          <div className="pt-6 border-t border-gray-300 text-center">
            <p className="text-xs uppercase tracking-widest text-gray-500">
              © {new Date().getFullYear()} Themedge — Tutti i diritti riservati
            </p>
          </div>
        </div>
      </footer>
    </div>
  );
}

// ============================================
// COMPONENTI
// ============================================

function ArticleHero({ article }: { article: any }) {
  return (
    <article>
      <Link href={`/articolo/${article.slug}`} className="block group">
        {article.featured_image && (
          <div className="aspect-[16/10] mb-5 overflow-hidden bg-gray-100">
            <img
              src={article.featured_image}
              alt={article.title}
              className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
          </div>
        )}
        <div className="mb-3 flex items-center gap-3 text-xs uppercase tracking-widest">
          {article.category && (
            <>
              <span className="font-bold" style={{ color: article.category.color || '#000' }}>
                {article.category.name}
              </span>
              <span className="text-gray-400">·</span>
            </>
          )}
          <time className="text-gray-500">{timeAgo(article.published_at)}</time>
        </div>
        <h2 className="font-serif text-4xl md:text-5xl font-black leading-[1.1] mb-4 group-hover:underline decoration-2 underline-offset-4">
          {article.title}
        </h2>
        {article.excerpt && (
          <p className="text-lg text-gray-700 leading-relaxed font-serif">
            {article.excerpt}
          </p>
        )}
        {article.author && (
          <p className="text-xs text-gray-500 mt-4 uppercase tracking-wider">
            di <strong>{article.author.name}</strong>
          </p>
        )}
      </Link>
    </article>
  );
}

function ArticleCompact({ article }: { article: any }) {
  return (
    <article>
      <Link href={`/articolo/${article.slug}`} className="block group">
        <div className="mb-2 flex items-center gap-3 text-xs uppercase tracking-widest">
          {article.category && (
            <span className="font-bold" style={{ color: article.category.color || '#000' }}>
              {article.category.name}
            </span>
          )}
        </div>
        <h3 className="font-serif text-xl font-bold leading-tight mb-2 group-hover:underline">
          {article.title}
        </h3>
        {article.excerpt && (
          <p className="text-gray-700 text-sm leading-relaxed line-clamp-3 font-serif">
            {article.excerpt}
          </p>
        )}
        <p className="text-xs text-gray-500 mt-2 uppercase tracking-wider">
          {timeAgo(article.published_at)}
        </p>
      </Link>
    </article>
  );
}

function ArticleCard({ article }: { article: any }) {
  return (
    <article>
      <Link href={`/articolo/${article.slug}`} className="block group">
        {article.featured_image && (
          <div className="aspect-video mb-4 overflow-hidden bg-gray-100">
            <img
              src={article.featured_image}
              alt={article.title}
              className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        )}
        <div className="mb-2 flex items-center gap-3 text-xs uppercase tracking-widest">
          {article.category && (
            <span className="font-bold" style={{ color: article.category.color || '#000' }}>
              {article.category.name}
            </span>
          )}
          <span className="text-gray-400">·</span>
          <time className="text-gray-500">{timeAgo(article.published_at)}</time>
        </div>
        <h3 className="font-serif text-lg font-bold leading-tight mb-2 group-hover:underline">
          {article.title}
        </h3>
        {article.excerpt && (
          <p className="text-gray-700 text-sm leading-relaxed line-clamp-2 font-serif">
            {article.excerpt}
          </p>
        )}
      </Link>
    </article>
  );
}

function ArticleFeaturedCategory({ article }: { article: any }) {
  return (
    <article>
      <Link href={`/articolo/${article.slug}`} className="block group">
        <div className="grid md:grid-cols-2 gap-6">
          {article.featured_image && (
            <div className="aspect-[4/3] overflow-hidden bg-gray-100">
              <img
                src={article.featured_image}
                alt={article.title}
                className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          )}
          <div className="flex flex-col justify-center">
            <div className="mb-2 flex items-center gap-3 text-xs uppercase tracking-widest">
              {article.category && (
                <span className="font-bold" style={{ color: article.category.color || '#000' }}>
                  {article.category.name}
                </span>
              )}
              <span className="text-gray-400">·</span>
              <time className="text-gray-500">{timeAgo(article.published_at)}</time>
            </div>
            <h3 className="font-serif text-2xl font-bold leading-tight mb-3 group-hover:underline">
              {article.title}
            </h3>
            {article.excerpt && (
              <p className="text-gray-700 leading-relaxed line-clamp-3 font-serif">
                {article.excerpt}
              </p>
            )}
            {article.author && (
              <p className="text-xs text-gray-500 mt-3 uppercase tracking-wider">
                di {article.author.name}
              </p>
            )}
          </div>
        </div>
      </Link>
    </article>
  );
}
