import Link from 'next/link';
import Sidebar from '@/components/Sidebar';

const API_URL = process.env.NEXT_PUBLIC_API_URL || 'https://admin.themedge.com/api';

async function getArticles() {
  try {
    const res = await fetch(`${API_URL}/articles?per_page=20`, { next: { revalidate: 60 } });
    if (!res.ok) return { data: [] };
    return res.json();
  } catch (e) { return { data: [] }; }
}

async function getCategories() {
  try {
    const res = await fetch(`${API_URL}/categories`, { next: { revalidate: 300 } });
    if (!res.ok) return { data: [] };
    return res.json();
  } catch (e) { return { data: [] }; }
}

function timeAgo(date: string) {
  const seconds = Math.floor((new Date().getTime() - new Date(date).getTime()) / 1000);
  const intervals: [number, string][] = [[31536000, 'anno'], [2592000, 'mese'], [86400, 'giorno'], [3600, 'ora'], [60, 'minuto']];
  for (const [secs, label] of intervals) {
    const counter = Math.floor(seconds / secs);
    if (counter > 0) return `${counter} ${label}${counter > 1 ? 'i' : ''} fa`;
  }
  return 'adesso';
}

export default async function HomePage() {
  const [articlesData, categoriesData] = await Promise.all([getArticles(), getCategories()]);
  const articles = articlesData.data || [];
  const categories = categoriesData.data || [];
  const [mainArticle, ...rest] = articles;
  const sideArticles = rest.slice(0, 2);
  const latest = rest.slice(2, 8);
  const popular = [...articles].sort((a: any, b: any) => b.views - a.views).slice(0, 5);

  return (
    <div className="max-w-7xl mx-auto px-4 py-8">
      {articles.length === 0 ? (
        <div className="text-center py-20">
          <p className="text-gray-500 italic font-serif text-2xl mb-4">Il giornale sta nascendo.</p>
        </div>
      ) : (
        <>
          <div className="bg-red-700 text-white mb-8">
            <div className="flex items-center gap-3 px-4 py-2">
              <span className="bg-white text-red-700 text-xs font-bold px-2 py-1 uppercase tracking-widest flex-shrink-0">
                Ultim&apos;ora
              </span>
              <Link href={`/articolo/${mainArticle.slug}`} className="text-sm font-semibold hover:underline truncate">
                {mainArticle.title}
              </Link>
            </div>
          </div>

          <section className="grid lg:grid-cols-3 gap-8 pb-8 mb-8 border-b-2 border-black">
            <div className="lg:col-span-2">
              <ArticleHero article={mainArticle} />
            </div>
            <div className="flex flex-col gap-6 divide-y divide-gray-300 lg:border-l lg:pl-8">
              {sideArticles.map((article: any, i: number) => (
                <div key={article.id} className={i > 0 ? 'pt-6' : ''}>
                  <ArticleCompact article={article} />
                </div>
              ))}
            </div>
          </section>

          <div className="grid lg:grid-cols-3 gap-10">
            <div className="lg:col-span-2">
              <h2 className="font-serif text-2xl font-bold mb-6 pb-2 border-b-2 border-black flex items-center gap-3">
                <span className="w-1 h-6 bg-red-700"></span>
                Ultime notizie
              </h2>
              <div className="grid md:grid-cols-2 gap-6 mb-10">
                {latest.map((article: any) => (
                  <ArticleCard key={article.id} article={article} />
                ))}
              </div>

              <h2 className="font-serif text-2xl font-bold mb-6 pb-2 border-b-2 border-black flex items-center gap-3">
                <span className="w-1 h-6 bg-red-700"></span>
                Più letti
              </h2>
              <ol className="space-y-5">
                {popular.map((article: any, i: number) => (
                  <li key={article.id} className="flex gap-4">
                    <span className="font-serif text-4xl font-bold text-gray-200 leading-none">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <div>
                      <Link href={`/articolo/${article.slug}`} className="hover:underline">
                        <h3 className="font-serif font-bold leading-tight mb-1 text-base">{article.title}</h3>
                      </Link>
                      <p className="text-xs uppercase tracking-wider text-gray-500">{timeAgo(article.published_at)}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>

            <Sidebar articles={articles} categories={categories} />
          </div>
        </>
      )}
    </div>
  );
}

function ArticleHero({ article }: { article: any }) {
  return (
    <article>
      <Link href={`/articolo/${article.slug}`} className="block group">
        {article.featured_image && (
          <div className="aspect-[16/10] mb-5 overflow-hidden bg-gray-100">
            <img src={article.featured_image} alt={article.title} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
        )}
        <div className="mb-3 flex items-center gap-3 text-xs uppercase tracking-widest">
          {article.category && (
            <>
              <span className="font-bold" style={{ color: article.category.color || '#000' }}>{article.category.name}</span>
              <span className="text-gray-400">·</span>
            </>
          )}
          <time className="text-gray-500">{timeAgo(article.published_at)}</time>
        </div>
        <h2 className="font-serif text-4xl md:text-5xl font-black leading-[1.1] mb-4 group-hover:underline decoration-2 underline-offset-4">{article.title}</h2>
        {article.excerpt && <p className="text-lg text-gray-700 leading-relaxed font-serif">{article.excerpt}</p>}
        {article.author && <p className="text-xs text-gray-500 mt-4 uppercase tracking-wider">di <strong>{article.author.name}</strong></p>}
      </Link>
    </article>
  );
}

function ArticleCompact({ article }: { article: any }) {
  return (
    <article>
      <Link href={`/articolo/${article.slug}`} className="block group">
        <div className="mb-2 flex items-center gap-3 text-xs uppercase tracking-widest">
          {article.category && <span className="font-bold" style={{ color: article.category.color || '#000' }}>{article.category.name}</span>}
        </div>
        <h3 className="font-serif text-xl font-bold leading-tight mb-2 group-hover:underline">{article.title}</h3>
        {article.excerpt && <p className="text-gray-700 text-sm leading-relaxed line-clamp-3 font-serif">{article.excerpt}</p>}
        <p className="text-xs text-gray-500 mt-2 uppercase tracking-wider">{timeAgo(article.published_at)}</p>
      </Link>
    </article>
  );
}

function ArticleCard({ article }: { article: any }) {
  return (
    <article>
      <Link href={`/articolo/${article.slug}`} className="block group">
        {article.featured_image && (
          <div className="aspect-video mb-4 overflow-hidden bg-gray-100">
            <img src={article.featured_image} alt={article.title} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
        )}
        <div className="mb-2 flex items-center gap-3 text-xs uppercase tracking-widest">
          {article.category && <span className="font-bold" style={{ color: article.category.color || '#000' }}>{article.category.name}</span>}
          <span className="text-gray-400">·</span>
          <time className="text-gray-500">{timeAgo(article.published_at)}</time>
        </div>
        <h3 className="font-serif text-lg font-bold leading-tight mb-2 group-hover:underline">{article.title}</h3>
        {article.excerpt && <p className="text-gray-700 text-sm leading-relaxed line-clamp-2 font-serif">{article.excerpt}</p>}
      </Link>
    </article>
  );
}
