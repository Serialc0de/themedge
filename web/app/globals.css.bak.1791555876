@import "tailwindcss";

@theme {
  --font-serif: var(--font-playfair), Georgia, serif;
  --font-sans: var(--font-inter), system-ui, sans-serif;
  --color-news-black: #0a0a0a;
  --color-news-gray: #666;
  --color-news-light: #f7f7f5;
  --color-news-red: #c8102e;
}

body {
  background: #ffffff;
  color: var(--color-news-black);
}

.prose {
  max-width: 65ch;
}

.prose p {
  margin-bottom: 1.5em;
  line-height: 1.75;
  font-size: 1.125rem;
}

.prose p:first-of-type::first-letter {
  font-family: var(--font-serif);
  font-weight: 900;
  font-size: 4em;
  line-height: 0.9;
  float: left;
  margin: 0.05em 0.1em 0 0;
  color: #0a0a0a;
}

.prose h2 {
  font-family: var(--font-serif);
  font-weight: 800;
  font-size: 1.875em;
  margin-top: 2em;
  margin-bottom: 0.75em;
  line-height: 1.2;
}

.prose h3 {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 1.5em;
  margin-top: 1.75em;
  margin-bottom: 0.5em;
  line-height: 1.3;
}

.prose blockquote {
  border-left: 4px solid #c8102e;
  padding-left: 1.5em;
  font-style: italic;
  font-family: var(--font-serif);
  font-size: 1.35em;
  margin: 2em 0;
  color: #333;
  line-height: 1.5;
}

.prose a {
  color: #c8102e;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.prose a:hover {
  text-decoration-thickness: 2px;
}

.prose ul, .prose ol {
  margin: 1.5em 0;
  padding-left: 1.5em;
}

.prose li {
  margin-bottom: 0.5em;
}

.prose img {
  margin: 2em 0;
  width: 100%;
}
