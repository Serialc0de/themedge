@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

@source "../app/**/*.{ts,tsx}";
@source "../components/**/*.{ts,tsx}";

@theme {
  --font-serif: var(--font-playfair), Georgia, serif;
  --font-sans: var(--font-inter), system-ui, sans-serif;
  --color-news-black: #0a0a0a;
  --color-news-gray: #666;
  --color-news-light: #f7f7f5;
  --color-news-red: #c8102e;
}

body {
  background: #ffffff;
  color: #0a0a0a;
}

/* ===== PROSE ===== */
.prose {
  max-width: 65ch;
}

.prose p {
  margin-bottom: 1.5em;
  line-height: 1.75;
  font-size: 1.125rem;
}

.prose p:first-of-type::first-letter {
  font-family: var(--font-serif);
  font-weight: 900;
  font-size: 4em;
  line-height: 0.9;
  float: left;
  margin: 0.05em 0.1em 0 0;
  color: #0a0a0a;
}

.prose h2 {
  font-family: var(--font-serif);
  font-weight: 800;
  font-size: 1.875em;
  margin-top: 2em;
  margin-bottom: 0.75em;
  line-height: 1.2;
}

.prose h3 {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 1.5em;
  margin-top: 1.75em;
  margin-bottom: 0.5em;
  line-height: 1.3;
}

.prose blockquote {
  border-left: 4px solid #c8102e;
  padding-left: 1.5em;
  font-style: italic;
  font-family: var(--font-serif);
  font-size: 1.35em;
  margin: 2em 0;
  color: #333;
  line-height: 1.5;
}

.prose a {
  color: #c8102e;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.prose a:hover {
  text-decoration-thickness: 2px;
}

.prose ul, .prose ol {
  margin: 1.5em 0;
  padding-left: 1.5em;
}

.prose li {
  margin-bottom: 0.5em;
}

.prose img {
  margin: 2em 0;
  width: 100%;
}

/* ============================================
   DARK MODE
   ============================================ */

.dark {
  color-scheme: dark;
}

.dark body {
  background: #0a0a0a !important;
  color: #f5f5f5 !important;
}

/* Sfondi */
.dark .bg-white {
  background-color: #0a0a0a !important;
}

.dark .bg-gray-50 {
  background-color: #111111 !important;
}

.dark .bg-gray-100 {
  background-color: #1a1a1a !important;
}

.dark .bg-gray-200 {
  background-color: #262626 !important;
}

.dark .bg-red-50 {
  background-color: #2a0a0a !important;
}

/* Testi */
.dark .text-black,
.dark .text-gray-900 {
  color: #f5f5f5 !important;
}

.dark .text-gray-800 {
  color: #e5e5e5 !important;
}

.dark .text-gray-700 {
  color: #d1d5db !important;
}

.dark .text-gray-600 {
  color: #a1a1aa !important;
}

.dark .text-gray-500 {
  color: #71717a !important;
}

.dark .text-gray-400 {
  color: #52525b !important;
}

.dark .text-gray-300 {
  color: #3f3f46 !important;
}

.dark .text-gray-200 {
  color: #27272a !important;
}

/* Bordi */
.dark .border-black,
.dark .border-gray-900 {
  border-color: #f5f5f5 !important;
}

.dark .border-gray-300 {
  border-color: #333333 !important;
}

.dark .border-gray-200 {
  border-color: #262626 !important;
}

.dark .border-gray-100 {
  border-color: #1a1a1a !important;
}

/* Divide */
.dark .divide-gray-300 > * + * {
  border-color: #333333 !important;
}

.dark .divide-gray-100 > * + * {
  border-color: #1a1a1a !important;
}

/* Prose dark */
.dark .prose {
  color: #d1d5db !important;
}

.dark .prose h1,
.dark .prose h2,
.dark .prose h3,
.dark .prose h4 {
  color: #f5f5f5 !important;
}

.dark .prose p,
.dark .prose li {
  color: #d1d5db !important;
}

.dark .prose p:first-of-type::first-letter {
  color: #f5f5f5 !important;
}

.dark .prose blockquote {
  border-left-color: #c8102e !important;
  color: #a1a1aa !important;
}

.dark .prose a {
  color: #ff6b6b !important;
}

.dark .prose code {
  background: #1a1a1a !important;
  color: #f5f5f5 !important;
}

.dark .prose strong {
  color: #f5f5f5 !important;
}

/* Input */
.dark input,
.dark textarea,
.dark select {
  background-color: #1a1a1a !important;
  color: #f5f5f5 !important;
  border-color: #333333 !important;
}

.dark input::placeholder,
.dark textarea::placeholder {
  color: #52525b !important;
}

/* Hover */
.dark .hover\:bg-gray-100:hover {
  background-color: #1a1a1a !important;
}

.dark .hover\:text-black:hover {
  color: #f5f5f5 !important;
}

/* Header/nav in dark */
.dark header,
.dark nav {
  background-color: #0a0a0a !important;
  border-color: #f5f5f5 !important;
}

.dark footer {
  background-color: #111111 !important;
  border-color: #f5f5f5 !important;
}

/* Transizioni */
* {
  transition-property: background-color, border-color, color;
  transition-duration: 200ms;
  transition-timing-function: ease-out;
}
